DATABASE_URL="postgresql://user:pass@localhost:5432/examify"
JWT_SECRET="replace-with-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# Optional: base64 PKCS8 Ed25519 private key for signing certificates (auto-generated in dev)
SIGNING_PRIVATE_KEY=""

# ─── Email option A (recommended on Render free): Google Apps Script relay over HTTPS ─────
# Render's free plan blocks SMTP. Set up the relay in 5 minutes: scripts/google-apps-script/SETUP.md
EMAIL_RELAY_URL=""      # the Apps Script Web app URL (ends in /exec)
EMAIL_RELAY_SECRET=""   # the same long random secret you put in Code.gs

# ─── Email option B: Gmail SMTP with an App Password (hosts that allow SMTP) ─────────────────────────────────
# Leave SMTP_USER / SMTP_PASS empty to keep email off: emails are still recorded
# and previewable in Admin → Email log, but nothing is delivered.
# 1. Turn on 2-Step Verification for the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
SMTP_USER=""            # the Gmail / Google Workspace address, e.g. examify.notify@gmail.com
SMTP_PASS=""            # the 16-character App Password (spaces are fine)
EMAIL_FROM=""           # optional display name + address, e.g. "Examify <examify.notify@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465           # 465 (SSL) or 587 (STARTTLS)
EMAIL_TIMEZONE="Asia/Karachi"   # time zone used for dates inside emails

# ─── AI marking assistant (Claude) ──────────────────────────────────────────
# Paste a Claude API key to turn on AI-suggested marks for written answers.
# Get one at https://platform.claude.com/settings/keys. Leave empty to keep the assistant off.
ANTHROPIC_API_KEY=""
# Optional: AI_GRADING_MODEL (default claude-opus-5-5), AI_GRADING_EFFORT (low|medium|high, default medium)
